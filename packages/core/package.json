{
  "name": "@agenticvids/core",
  "version": "0.1.0",
  "description": "React runtime for frame-deterministic animated video: timeline, sequences, tweens, springs, camera, audio, LaTeX.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./latex": "./src/latex.tsx",
    "./player": "./src/player/index.tsx",
    "./harness": "./src/harness/index.tsx",
    "./package.json": "./package.json",
    "./rigs": "./src/rigs/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.8",
    "katex": "^0.16.22"
  },
  "devDependencies": {
    "@types/babel__standalone": "^7.1.9",
    "@types/katex": "^0.16.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vitest": "^4.0.0"
  }
}
