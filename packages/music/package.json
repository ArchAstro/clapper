{
  "name": "@clapper/music", "version": "0.1.0", "type": "module",
  "description": "Typed musical scores, tempo maps and MIDI interchange for Clapper",
  "main": "./dist/index.js", "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }, "./midi": { "types": "./dist/midi.d.ts", "default": "./dist/midi.js" }, "./package.json": "./package.json" },
  "files": ["dist"],
  "scripts": { "build": "tsc -p tsconfig.json", "typecheck": "tsc -p tsconfig.json --noEmit", "test": "vitest run" },
  "dependencies": { "@tonejs/midi": "2.0.28" },
  "devDependencies": { "typescript": "^5.9.0", "vitest": "^4.0.0" }
}
