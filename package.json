{
  "name": "clapper-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "postinstall": "pnpm --dir packages/music build",
    "test:music": "node scripts/test-music.mjs",
    "build:standalone": "node scripts/build-release.mjs",
    "test:standalone": "node scripts/test-standalone.mjs",
    "pack:npm": "node scripts/pack-npm.mjs",
    "test:npm": "node scripts/test-npm.mjs",
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "preview": "pnpm --filter intern-promo preview",
    "render": "pnpm --filter intern-promo render"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
