{
  "name": "intern-promo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "preview": "clapper preview src/index.tsx",
    "render": "clapper render src/index.tsx --composition intern-promo --out out/intern-promo.mp4",
    "render:film": "clapper render src/index.tsx --composition intern-film --out out/intern-film.mp4 --crf 20 --loudnorm=-18",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@archastro/clapper": "workspace:*",
    "@archastro/clapper-core": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
